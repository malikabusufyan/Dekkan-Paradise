MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dekkan-paradise?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
PORT=5000

# Comma-separated list of allowed frontend origins (local dev + production).
CLIENT_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# Used to build absolute /uploads URLs when R2 isn't configured (local-disk fallback).
# Locally this can stay unset (defaults to http://localhost:<PORT>).
# In production, set this to your deployed backend's own URL (e.g. Render's).
PUBLIC_SERVER_URL=http://localhost:5000

# Optional: Cloudflare R2 (S3-compatible) for persistent file storage in production.
# Leave all of these blank to use local disk instead (fine for local dev; on most
# free hosting tiers local disk is wiped on every restart/redeploy).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
